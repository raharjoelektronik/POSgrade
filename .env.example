# ---------------------------------------------------------------------------
# POSgrade - contoh konfigurasi
# Salin file ini menjadi `.env` lalu sesuaikan bila perlu.
# Server Node membaca file `.env` ini secara manual (zero dependency).
# ---------------------------------------------------------------------------

# Port untuk web server Node.js (frontend + proxy)
PORT=3000
HOST=127.0.0.1

# Lokasi PocketBase (dipakai oleh proxy /pb/* dan oleh skrip seed)
PB_URL=http://127.0.0.1:8090

# Kredensial superuser PocketBase (DIPAKAI HANYA oleh skrip CLI / seed,
# JANGAN pernah dikirim ke browser).
PB_ADMIN_EMAIL=admin@posgrade.local
PB_ADMIN_PASSWORD=posgrade123

# Mode pengembangan: cache dimatikan & proxy request di-log
DEV=1
